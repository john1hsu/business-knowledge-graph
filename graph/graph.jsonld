    {
      "@id": "kt:razor-and-blades-model",
      "@type": "kto:BusinessModel",
      "skos:prefLabel": "Razor and Blades",
      "skos:definition": "A business model in which a firm sells a durable base product cheaply, sometimes below cost, and earns its profit on the consumables or complements that customers must buy repeatedly to use it.",
      "kto:domain": "business-models",
      "dcterms:created": "2026-11-09",
