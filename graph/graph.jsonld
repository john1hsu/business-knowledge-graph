          "dcterms:publisher": "Social Behavior and Personality 12(2), 1984",
          "schema:url": "https://sbp-journal.com/index.php/sbp/article/view/444",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Diverse Perspectives on the Groupthink Theory – A Literary Review",
          "dcterms:publisher": "Emerging Leadership Journeys 4(1), Regent University, 2011",
          "schema:url": "https://www.regent.edu/journal/emerging-leadership-journeys/groupthink-theory/",
