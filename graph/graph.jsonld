    {
      "@id": "kt:truth-in-negotiations-act",
      "@type": "kto:Regulation",
      "skos:prefLabel": "Truth in Negotiations Act",
      "skos:definition": "A 1962 US federal statute, now codified at 10 U.S.C. chapter 271 and 41 U.S.C. chapter 35, that makes contractors in largely non-competitive negotiations above a dollar threshold disclose and certify their cost or pricing data as accurate, complete and current, and lets the government cut the price if the data prove defective.",
      "kto:domain": "government-contracting-and-public-sector",
      "dcterms:created": "2026-11-11",
