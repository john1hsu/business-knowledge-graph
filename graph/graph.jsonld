    {
      "@id": "kt:indefinite-delivery-indefinite-quantity",
      "@type": "kto:Concept",
      "skos:prefLabel": "Indefinite Delivery, Indefinite Quantity (IDIQ) Contract",
      "skos:definition": "A US federal contract that buys an unspecified quantity of supplies or services, between a guaranteed minimum and a stated maximum, over a fixed period, with the actual work ordered later through individual task orders (services) or delivery orders (supplies).",
