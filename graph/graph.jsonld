    {
      "@id": "kt:kodak-decline",
      "@type": "kto:Case",
      "skos:prefLabel": "Kodak Decline",
      "skos:definition": "The long slide of Eastman Kodak from dominant film-photography franchise to its January 2012 Chapter 11 filing, a case usually told as a failure to see digital coming but which recent business-history research reframes as repeated, well-funded renewal attempts defeated by high aspirations, timing uncertainty and a film business that stayed profitable for too long.",
      "kto:domain": "business-history-and-cases",
      "dcterms:created": "2026-11-09",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "The Problem of Sustaining a Successful Enterprise: Kodak's Multiple Takes at Strategic Renewal that Culminated in Failure",
          "dcterms:publisher": "Business History Review 99(1), 3–38 (2025), Cambridge University Press (record via EconPapers/RePEc)",
          "schema:url": "https://econpapers.repec.org/RePEc:cup:buhirw:v:99:y:2025:i:1:p:3-38_2",
          "kto:sourceType": "peer-reviewed"
        },
        {
