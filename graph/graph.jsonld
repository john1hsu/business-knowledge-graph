    {
      "@id": "kt:price-elasticity",
      "@type": "kto:Metric",
      "skos:prefLabel": "Price Elasticity",
      "skos:definition": "The percentage change in quantity demanded divided by the percentage change in price; it tells a firm whether a price change will raise or lower revenue and is the core input to pricing decisions.",
      "kto:domain": "marketing",
      "dcterms:created": "2026-11-09",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Principles of Economics, Book III, Chapter IV: The Elasticity of Wants (8th ed., 1920)",
          "dcterms:publisher": "Library of Economics and Liberty (Liberty Fund)",
          "schema:url": "https://www.econlib.org/library/Marshall/marP12.html",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "5.3 Elasticity and Pricing — Principles of Economics 3e",
          "dcterms:publisher": "OpenStax, Rice University",
          "schema:url": "https://openstax.org/books/principles-economics-3e/pages/5-3-elasticity-and-pricing",
          "kto:sourceType": "textbook"
