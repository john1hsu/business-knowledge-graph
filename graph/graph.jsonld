          "schema:url": "https://blog.rchss.sinica.edu.tw/FCLai/wp-content/uploads/2016/11/980730_Network-Externalities-Competition-and-Compatibility_Michael-L.-Katz-and-Carl-Shapiro-1985_AER-753_p.424-440.pdf",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Systems Competition and Network Effects (RePEc record, DOI 10.1257/jep.8.2.93)",
