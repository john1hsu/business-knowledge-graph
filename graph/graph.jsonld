      "@id": "kt:group-decision-making",
      "@type": "kto:Concept",
      "skos:prefLabel": "Group Decision Making: How Groups Combine Individual Judgments into Choices",
      "skos:definition": "The process by which two or more people jointly evaluate alternatives and reach a single choice; it can pool knowledge and build commitment, but research on hidden profiles, group polarization and groupthink shows that unstructured discussion often wastes that potential.",
      "kto:domain": "organizational-behavior",
      "dcterms:created": "2026-11-13",
      "prov:wasDerivedFrom": [
