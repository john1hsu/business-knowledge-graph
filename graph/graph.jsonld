    {
      "@id": "kt:psychological-safety",
      "@type": "kto:Concept",
      "skos:prefLabel": "Psychological Safety",
      "skos:definition": "A shared belief among members of a team that it is safe to take interpersonal risks such as asking questions, admitting mistakes or disagreeing; formalised for work teams by Amy Edmondson in 1999 and linked to team learning behavior and performance.",
      "kto:domain": "organizational-behavior",
      "dcterms:created": "2026-11-08",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Psychological Safety and Learning Behavior in Work Teams",
          "dcterms:publisher": "Administrative Science Quarterly 44(2), 1999 (copy hosted by MIT)",
          "schema:url": "https://web.mit.edu/curhan/www/docs/Articles/15341_Readings/Group_Performance/Edmondson%20Psychological%20safety.pdf",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Psychological Safety: A Meta-Analytic Review and Extension",
          "dcterms:publisher": "Personnel Psychology 70(1), 2017 (open-access copy via CORE)",
          "schema:url": "https://core.ac.uk/download/217291252.pdf",
          "kto:sourceType": "peer-reviewed"
