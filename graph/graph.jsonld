    {
      "@id": "kt:amy-edmondson",
      "@type": "kto:Person",
      "skos:prefLabel": "Amy Edmondson",
      "skos:definition": "Harvard Business School's Novartis Professor of Leadership and Management, whose field research on hospital and manufacturing teams introduced team psychological safety and the idea of \"teaming\", and whose later work offers a typology for learning from failure.",
      "kto:domain": "organizational-behavior",
      "dcterms:created": "2026-11-09",
