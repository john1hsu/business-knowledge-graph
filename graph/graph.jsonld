          "dcterms:publisher": "Benjamin E. Hermalin and Michael S. Weisbach, FRBNY Economic Policy Review 9(1), April 2003",
          "schema:url": "https://www.newyorkfed.org/medialibrary/media/research/epr/03v09n1/0304herm.html",
