    {
      "@id": "kt:lean-startup",
      "@type": "kto:Practice",
      "skos:prefLabel": "Lean Startup: Validated Learning Through the Build-Measure-Learn Loop",
      "skos:definition": "An entrepreneurial methodology, named by Eric Ries and built on Steve Blank's customer development, that treats a new venture's business model as a set of untested hypotheses and tests them quickly with minimum viable products and customer feedback, then perseveres, pivots or stops based on the evidence.",
      "kto:domain": "innovation-and-entrepreneurship",
      "dcterms:created": "2026-11-13",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Why the Lean Start-Up Changes Everything",
          "dcterms:publisher": "Harvard Business Review 91(5), May 2013 (reprint hosted by Gustavus Adolphus College)",
          "schema:url": "https://gustavus.edu/academics/departments/business-and-economics/concertFiles/media/2020_Gustie_Cup/Blank_2013.pdf",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Hypothesis-Driven Entrepreneurship: The Lean Startup (HBS Background Note 812-095)",
          "dcterms:publisher": "Harvard Business School (via SSRN)",
          "schema:url": "https://papers.ssrn.com/abstract=2037237",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "Teaching a 'Lean Startup' Strategy",
          "dcterms:publisher": "Harvard Business School, Working Knowledge",
          "schema:url": "https://www.library.hbs.edu/working-knowledge/teaching-a-lean-startup-strategy",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "A Scientific Approach to Entrepreneurial Decision Making: Evidence from a Randomized Control Trial",
