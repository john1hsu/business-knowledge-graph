    {
      "@id": "kt:andrew-van-de-ven",
      "@type": "kto:Person",
      "skos:prefLabel": "Andrew Van de Ven",
      "skos:definition": "American organization scholar (died 2022) at the University of Minnesota's Carlson School of Management who co-created the Nominal Group Technique, led the Minnesota Innovation Research Program that tracked innovations in real time, co-authored a widely used typology of four process theories of organizational change, and championed \"engaged scholarship\" linking research and practice.",
      "kto:domain": "innovation-and-entrepreneurship",
      "dcterms:created": "2026-11-11",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Remembering Professor Emeritus Andy Van de Ven",
          "dcterms:publisher": "Carlson School of Management, University of Minnesota",
          "schema:url": "https://carlsonschool.umn.edu/news/remembering-professor-emeritus-andy-van-de-ven",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "About Professor Van de Ven (Van de Ven Engaged Scholarship Conference)",
          "dcterms:publisher": "Carlson School of Management, University of Minnesota",
          "schema:url": "https://carlsonschool.umn.edu/conferences/van-de-ven-engaged-scholarship-conference/about-professor-van-de-ven",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "Remembering Andy Van de Ven",
          "dcterms:publisher": "Martin Kilduff, UCL Discovery (University College London repository)",
          "schema:url": "https://discovery.ucl.ac.uk/10152298/1/Kilduff_REMEMBERING%20ANDY%20VAN%20DE%20VEN.pdf",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "Explaining Development and Change in Organizations (Academy of Management Review 20(3):510-540, 1995)",
          "dcterms:publisher": "Andrew H. Van de Ven and Marshall Scott Poole, via CORE",
          "schema:url": "https://core.ac.uk/download/357583486.pdf",
          "kto:sourceType": "primary"
        },
        {
