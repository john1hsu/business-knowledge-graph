      "@id": "kt:activity-based-costing",
      "@type": "kto:Practice",
      "skos:prefLabel": "Activity-Based Costing: Assigning Overhead by Activities",
      "skos:definition": "A managerial cost-accounting method, popularised by Robin Cooper and Robert S. Kaplan in the late 1980s, that assigns overhead to products, services and customers through multiple activity cost pools and cost drivers instead of a single volume-based rate, to reveal which offerings actually make money.",
      "kto:domain": "accounting-and-reporting",
      "dcterms:created": "2026-11-12",
