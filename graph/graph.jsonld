      "@id": "kt:agency-costs",
      "@type": "kto:Concept",
      "skos:prefLabel": "Agency Costs",
      "skos:definition": "The total cost that arises when a principal delegates decisions to an agent whose interests differ, defined by Jensen and Meckling (1976) as the sum of the principal's monitoring expenditures, the agent's bonding expenditures, and the residual loss that remains.",
      "kto:domain": "business-ethics-and-governance",
      "dcterms:created": "2026-10-30",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Theory of the Firm: Managerial Behavior, Agency Costs and Ownership Structure",
          "dcterms:publisher": "Journal of Financial Economics (course copy, University of Illinois)",
          "schema:url": "https://josephmahoney.web.illinois.edu/BA549_Fall%202012/Session%205/5_Jensen_Meckling%20(1976).pdf",
          "kto:sourceType": "primary"
        },
