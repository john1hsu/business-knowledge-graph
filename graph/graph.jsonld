          "dcterms:publisher": "International Accounting Standards Board",
          "schema:url": "https://cdn.ifrs.org/content/dam/ifrs/project/goodwill-and-impairment/exposure-draft-2024/iasb-bc-2024-1-bcdgi.pdf",
          "kto:sourceType": "standards-body"
        },
        {
          "dcterms:title": "Has goodwill accounting gone bad?",
          "dcterms:publisher": "Review of Accounting Studies 22(2), 964-1003 (Kevin K. Li and Richard G. Sloan)",
          "schema:url": "https://ideas.repec.org/a/spr/reaccs/v22y2017i2d10.1007_s11142-017-9401-7.html",
          "kto:sourceType": "peer-reviewed"
