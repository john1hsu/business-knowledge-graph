    {
      "@id": "kt:okrs",
      "@type": "kto:Framework",
      "skos:prefLabel": "Objectives and Key Results (OKRs)",
      "skos:definition": "A goal-setting framework, developed by Andy Grove at Intel from Peter Drucker's management by objectives and popularised by John Doerr at Google, in which teams pair a short qualitative objective with a few measurable, verifiable key results, typically set and graded each quarter and kept separate from compensation.",
      "kto:domain": "leadership-and-management",
      "dcterms:created": "2026-11-08",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "What is an OKR? Definition and Examples",
          "dcterms:publisher": "What Matters",
          "schema:url": "https://www.whatmatters.com/faqs/okr-meaning-definition-example",
          "kto:sourceType": "organization"
        },
        {
          "dcterms:title": "The OKR Origin Story",
          "dcterms:publisher": "What Matters",
          "schema:url": "https://www.whatmatters.com/stories/the-origin-story",
          "kto:sourceType": "organization"
        },
        {
          "dcterms:title": "Google's OKR Playbook",
          "dcterms:publisher": "Google (hosted by What Matters)",
          "schema:url": "https://www.whatmatters.com/resources/google-okr-playbook",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Do objectives and key results solve organizational performance measurement issues?",
          "dcterms:publisher": "Benchmarking: An International Journal (Emerald)",
          "schema:url": "https://emerald.com/insight/content/doi/10.1108/BIJ-07-2022-0464/full/html",
          "kto:sourceType": "peer-reviewed"
        },
