    {
      "@id": "kt:organizational-ambidexterity",
      "@type": "kto:Concept",
      "skos:prefLabel": "Organizational Ambidexterity",
      "skos:definition": "An organization's capacity to exploit its existing businesses efficiently while simultaneously exploring new technologies and markets, achieved either by separating exploratory and exploitative units under a shared senior team (structural ambidexterity) or by a context that lets individuals split their time between alignment and adaptation (contextual ambidexterity).",
      "kto:domain": "innovation-and-entrepreneurship",
      "dcterms:created": "2026-11-08",
