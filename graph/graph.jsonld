    {
      "@id": "kt:high-performance-teams",
      "@type": "kto:Concept",
      "skos:prefLabel": "High-Performance Teams",
      "skos:definition": "Small groups with complementary skills, a common purpose and goals, an agreed approach and mutual accountability whose collective work products exceed what members would achieve alone; studied by Katzenbach and Smith (1993) and, as a set of design conditions, by J. Richard Hackman.",
      "kto:domain": "organizational-behavior",
      "dcterms:created": "2026-11-10",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "The Discipline of Teams",
          "dcterms:publisher": "Harvard Business Review 71(2), March-April 1993 (copy hosted by Stanford HCI course readings)",
          "schema:url": "https://hci.stanford.edu/courses/cs147/2015/au/readings/restricted/The%20Discipline%20of%20Teams.html",
          "kto:sourceType": "primary"
        },
        {
