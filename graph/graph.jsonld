          "dcterms:publisher": "American Economic Review (SSRN)",
          "schema:url": "https://papers.ssrn.com/abstract=99580",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Agency costs, ownership structure and corporate governance mechanisms",
          "dcterms:publisher": "Journal of Banking and Finance",
          "schema:url": "https://pure.psu.edu/en/publications/agency-costs-ownership-structure-and-corporate-governance-mechani/",
          "kto:sourceType": "peer-reviewed"
        },
