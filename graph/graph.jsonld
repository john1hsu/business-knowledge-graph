      "@id": "kt:goodwill",
      "@type": "kto:Concept",
      "skos:prefLabel": "Goodwill",
      "skos:definition": "An intangible asset recognised in a business combination, measured as the residual of the consideration paid over the acquired net identifiable assets, and under both US GAAP and IFRS tested for impairment rather than amortised.",
      "kto:domain": "accounting-and-reporting",
      "dcterms:created": "2026-11-10",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "IAS 36 Impairment of Assets",
