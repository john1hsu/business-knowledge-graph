    {
      "@id": "kt:innovators-dilemma",
      "@type": "kto:Work",
      "skos:prefLabel": "The Innovator's Dilemma",
      "skos:definition": "Clayton Christensen's 1997 book, published by Harvard Business School Press, arguing that well-managed market leaders lose to entrants precisely because they keep serving their best customers, and the name for the resulting trap in which an incumbent's rational choices delay its response to new technology.",
      "kto:domain": "innovation-and-entrepreneurship",
      "dcterms:created": "2026-11-09",
