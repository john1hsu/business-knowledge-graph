    {
      "@id": "kt:bullwhip-effect",
      "@type": "kto:Concept",
      "skos:prefLabel": "Bullwhip Effect in Supply Chains",
      "skos:definition": "The tendency for the variance of orders to exceed the variance of underlying sales and to grow at each step upstream in a supply chain, so that suppliers far from the consumer see much larger demand swings than end customers actually generate.",
      "kto:domain": "operations-and-supply-chain",
      "dcterms:created": "2026-11-11",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Information Distortion in a Supply Chain: The Bullwhip Effect",
          "dcterms:publisher": "Management Science (author copy hosted by Bilkent University)",
          "schema:url": "https://courses.ie.bilkent.edu.tr/ie102/wp-content/uploads/sites/12/2019/02/Lee-Padmanabhan-Whang-1997-MS.pdf",
