    {
      "@id": "kt:goal-setting-theory",
      "@type": "kto:Theory",
      "skos:prefLabel": "Goal-Setting Theory: Specific, Difficult Goals and Performance",
      "skos:definition": "A theory of work motivation developed by Edwin Locke and Gary Latham holding that specific, difficult, accepted goals lead to higher task performance than easy or vague \"do your best\" goals, with effects moderated by commitment, feedback, ability and task complexity.",
