    {
      "@id": "kt:net-present-value",
      "@type": "kto:Metric",
      "skos:prefLabel": "Net Present Value: Discounting Future Cash Flows to Evaluate Investments",
      "skos:definition": "The present value of an investment's expected cash inflows minus the present value of its cash outflows, discounted at a rate reflecting the cost of capital and risk; the standard capital budgeting rule is to accept projects with a positive NPV because they are expected to add value to the firm.",
      "kto:domain": "corporate-finance",
      "dcterms:created": "2026-11-13",
      "prov:wasDerivedFrom": [
