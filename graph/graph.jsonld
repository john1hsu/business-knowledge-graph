          "schema:url": "https://iris.unibocconi.it/retrieve/d62dad76-4e6d-4bf0-a31c-d8f5b8c00213/10-1108_IJIEOM-06-2023-0054.pdf",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "How to Project Customer Retention",
          "dcterms:publisher": "Journal of Interactive Marketing 21(1), 2007, pp. 76–89 (Wharton faculty copy)",
          "schema:url": "https://faculty.wharton.upenn.edu/wp-content/uploads/2012/04/Fader_hardie_jim_07.pdf",
          "kto:sourceType": "peer-reviewed"
