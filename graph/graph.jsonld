      "@id": "kt:capital-asset-pricing-model",
      "@type": "kto:Theory",
      "skos:prefLabel": "Capital Asset Pricing Model: Pricing Systematic Risk",
      "skos:definition": "An equilibrium model of asset prices, published by William Sharpe in 1964 and also credited to John Lintner, holding that an asset's expected return equals the risk-free rate plus its beta times the market risk premium, so investors are paid only for risk that diversification cannot remove.",
      "kto:domain": "corporate-finance",
      "dcterms:created": "2026-11-12",
