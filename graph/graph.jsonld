      "@id": "kt:two-sided-market",
      "@type": "kto:Concept",
      "skos:prefLabel": "Two-Sided Market",
      "skos:definition": "A market in which a platform serves two distinct groups of users whose value from joining depends on participation by the other group, so the platform must set prices for both sides jointly and often subsidizes one side to attract the other.",
      "kto:domain": "business-models",
      "dcterms:created": "2026-10-30",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Platform Competition in Two-Sided Markets",
          "dcterms:publisher": "Journal of the European Economic Association (author copy, Universidad de Granada)",
          "schema:url": "https://www.ugr.es/~scarbo/ROCHETIR.pdf",
          "kto:sourceType": "primary"
        },
        {
