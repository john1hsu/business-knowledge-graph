    {
      "@id": "kt:clayton-christensen",
      "@type": "kto:Person",
      "skos:prefLabel": "Clayton Christensen",
      "skos:definition": "Harvard Business School professor (1952-2020) who developed the theory of disruptive innovation from a study of the disk drive industry, later popularized the jobs-to-be-done view of customer choice, and co-founded the consultancy Innosight and the Christensen Institute.",
