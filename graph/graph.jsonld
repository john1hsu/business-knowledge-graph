    {
      "@id": "kt:information-asymmetry",
      "@type": "kto:Theory",
      "skos:prefLabel": "Information Asymmetry: Unequal Knowledge Between Transacting Parties",
      "skos:definition": "The condition in which one party to a transaction knows more than the other about quality, risk or intentions, which can lead markets to price on averages, drive out high-quality sellers or low-risk buyers, and in extreme cases collapse, unless signaling, screening, guarantees or regulation close the gap.",
      "kto:domain": "managerial-economics",
      "dcterms:created": "2026-11-12",
      "prov:wasDerivedFrom": [
