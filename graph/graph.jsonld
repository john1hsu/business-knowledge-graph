        },
        {
          "dcterms:title": "Social Identity Maintenance Prescriptions for Preventing Groupthink: Reducing Identity Protection and Enhancing Intellectual Conflict",
          "dcterms:publisher": "International Journal of Conflict Management 5(3), 1994",
          "schema:url": "https://scilit.com/publications/224f0ade156235dc89f1052b999a8432",
