          "dcterms:publisher": "Administrative Science Quarterly 44(2), 1999 (Harvard DASH record)",
          "schema:url": "https://dash.harvard.edu/entities/publication/13a7b031-0fdd-45ec-a7e0-2b80e2bc679f",
          "kto:sourceType": "primary"
