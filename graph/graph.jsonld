    {
      "@id": "kt:modigliani-miller-theorem",
      "@type": "kto:Theory",
      "skos:prefLabel": "Modigliani-Miller Theorem",
      "skos:definition": "The proposition, introduced by Franco Modigliani and Merton Miller in 1958, that in a frictionless market a firm's value and average cost of capital are independent of its mix of debt and equity, so that any real-world effect of financing choices must come from taxes or other market imperfections.",
      "kto:domain": "corporate-finance",
      "dcterms:created": "2026-10-31",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "The Cost of Capital, Corporation Finance and the Theory of Investment",
          "dcterms:publisher": "American Economic Review (AEA Top 20 reprint)",
