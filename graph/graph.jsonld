    {
      "@id": "kt:disruptive-innovation",
      "@type": "kto:Theory",
      "skos:prefLabel": "Disruptive Innovation",
      "skos:definition": "Clayton Christensen's theory that resource-poor entrants can topple established firms by starting with products that are worse on mainstream performance measures but cheaper, simpler or more convenient, winning overlooked or non-consuming customers and then moving upmarket.",
