    {
      "@id": "kt:accrual-accounting",
      "@type": "kto:Concept",
      "skos:prefLabel": "Accrual Accounting",
      "skos:definition": "A basis of accounting that records revenues, expenses and other effects of transactions in the periods in which they occur, rather than when the related cash is received or paid.",
      "kto:domain": "accounting-and-reporting",
