          "dcterms:publisher": "RAND Journal of Economics (UCL Discovery record)",
          "schema:url": "https://discovery.ucl.ac.uk/id/eprint/4324/",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Strategies for Two-Sided Markets",
          "dcterms:publisher": "Harvard Business Review (course copy, KTH)",
          "schema:url": "https://www.kth.se/social/files/546b8e7ef2765474dd3f23fe/4.Eisenmann+et+al+(2006).pdf",
          "kto:sourceType": "practitioner-journal"
        },
        {
