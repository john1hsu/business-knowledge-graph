      "@id": "kt:network-effect",
      "@type": "kto:Concept",
      "skos:prefLabel": "Network Effect",
      "skos:definition": "The property of a product or system whose value to each user rises with the number of other users or of compatible complementary products, creating demand-side economies of scale that can make markets tip toward one dominant network.",
      "kto:domain": "managerial-economics",
      "dcterms:created": "2026-10-31",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Network Externalities, Competition, and Compatibility",
